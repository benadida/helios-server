# `fly deploy` builds from your working directory, not from git,
# so anything listed in .gitignore must be excluded here too.

# version control and editors
.git
.github
.gitignore
.idea
.DS_Store
*~

# local environments, caches and build output
.venv
venv*
__pycache__
*.pyc
*.egg-info
.cache
media/*

# local secrets and deploy scripts
env.sh
.env
.env.*
deploy-latest.sh
deploy-staging.sh
*.dump

# not needed at runtime
docs/
selenium/
reset.sh
settings_ci.py
fly.toml
*.md
